# --- Discord ---
# Token du bot (Developer Portal > Bot > Reset Token). Ne jamais le partager.
DISCORD_TOKEN=
# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# Optionnel : ID d'un serveur de test. Si renseigné, les commandes sont
# déployées uniquement sur ce serveur (mise à jour instantanée).
# Laisser vide en production pour un déploiement global.
DEV_GUILD_ID=

# --- Base de données ---
# Utilisés par docker-compose pour créer la base PostgreSQL.
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=discordbot
# URL de connexion utilisée par Prisma (adapter utilisateur / mot de passe / hôte).
DATABASE_URL=postgresql://discordbot:changez-moi@localhost:5432/discordbot?schema=public

# --- Application ---
# development | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
