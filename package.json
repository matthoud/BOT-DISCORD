{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Bot Discord modulaire : administration, modération, logs, bienvenue et divertissement.",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "commands:deploy": "tsx src/scripts/deploy-commands.ts",
    "commands:deploy:prod": "node dist/scripts/deploy-commands.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/client": "^6.0.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0",
    "prisma": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.12.0",
    "eslint": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
