generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Type d'action de modération enregistrée dans un cas.
enum CaseType {
  WARN
  TIMEOUT
  UNTIMEOUT
  KICK
  BAN
  UNBAN
  CLEAR_WARNINGS
}

/// Sanction appliquée automatiquement lorsqu'un seuil d'avertissements est atteint.
enum SanctionAction {
  TIMEOUT
  KICK
  BAN
}

/// Racine de toutes les données d'un serveur Discord.
model GuildConfig {
  guildId      String   @id
  /// Compteur servant à numéroter les cas de modération du serveur.
  caseCounter  Int      @default(0)
  /// Prévenir les membres sanctionnés par message privé.
  dmOnSanction Boolean  @default(true)
  /// Fuseau horaire (identifiant IANA) utilisé pour interpréter les dates saisies sur ce serveur.
  timezone     String   @default("Europe/Paris")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules             ModuleConfig[]
  moderationCases     ModerationCase[]
  warnings            Warning[]
  sanctionRules       SanctionRule[]
  welcomeConfig       WelcomeConfig?
  loggingConfig       LoggingConfig?
  customPermissions   CustomPermission[]
  levelConfig         LevelConfig?
  userExperiences     UserExperience[]
  levelRewards        LevelReward[]
  economyConfig       EconomyConfig?
  economyAccounts     EconomyAccount[]
  economyTransactions EconomyTransaction[]
  shopItems           ShopItem[]
  inventoryItems      InventoryItem[]
  suggestionConfig    SuggestionConfig?
  suggestions         Suggestion[]
  polls               Poll[]
  events              Event[]
  reminders           Reminder[]
}

/// Préférences propres à un utilisateur (indépendantes des serveurs).
model UserConfig {
  userId          String   @id
  /// Accepte de recevoir des messages privés du bot (notifications de sanction).
  dmNotifications Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// État d'une tâche périodique du planificateur (global, indépendant des serveurs).
model ScheduledTask {
  /// Identifiant de la tâche, de la forme `module:tache`.
  name                String    @id
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  /// Prochaine échéance ; une échéance dépassée pendant un arrêt est rattrapée au redémarrage.
  nextRunAt           DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?
  updatedAt           DateTime  @updatedAt
}

/// Activation d'un module pour un serveur, avec ses réglages libres.
model ModuleConfig {
  id        Int      @id @default(autoincrement())
  guildId   String
  moduleId  String
  enabled   Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, moduleId])
}

/// Une action de modération (un « cas »), numérotée par serveur.
model ModerationCase {
  id          Int       @id @default(autoincrement())
  guildId     String
  caseNumber  Int
  type        CaseType
  targetId    String
  targetTag   String
  moderatorId String
  reason      String
  /// Durée de la sanction en secondes (timeout, bannissement temporaire).
  duration    Int?
  /// Date de fin d'une sanction temporaire.
  expiresAt   DateTime?
  /// Faux tant qu'un bannissement temporaire attend sa levée automatique.
  resolved    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  guild    GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  warnings Warning[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@index([guildId, moderatorId])
  @@index([resolved, expiresAt])
}

/// Avertissement attribué à un membre.
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  active      Boolean  @default(true)
  caseId      Int?
  createdAt   DateTime @default(now())

  guild GuildConfig     @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  case  ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([guildId, userId, active])
  @@index([caseId])
}

/// Règle de sanction automatique : à `threshold` avertissements actifs, appliquer `action`.
model SanctionRule {
  id        Int            @id @default(autoincrement())
  guildId   String
  threshold Int
  action    SanctionAction
  /// Durée en secondes (obligatoire pour TIMEOUT, optionnelle pour BAN).
  duration  Int?
  createdAt DateTime       @default(now())

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, threshold])
}

/// Configuration du module de bienvenue.
model WelcomeConfig {
  guildId        String   @id
  enabled        Boolean  @default(false)
  channelId      String?
  welcomeMessage String   @default("Bienvenue {user} sur **{server}** ! Nous sommes désormais {memberCount} membres.")
  leaveEnabled   Boolean  @default(true)
  leaveMessage   String   @default("**{username}** a quitté {server}. Nous sommes désormais {memberCount} membres.")
  autoRoleId     String?
  updatedAt      DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

/// Salons de logs par catégorie d'événements.
model LoggingConfig {
  guildId             String   @id
  membersChannelId    String?
  messagesChannelId   String?
  channelsChannelId   String?
  rolesChannelId      String?
  moderationChannelId String?
  updatedAt           DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

/// Autorisation ou refus d'une commande pour un rôle donné.
model CustomPermission {
  id          Int      @id @default(autoincrement())
  guildId     String
  commandName String
  roleId      String
  /// true = rôle autorisé, false = rôle refusé.
  allow       Boolean
  createdAt   DateTime @default(now())

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, commandName, roleId])
  @@index([guildId, commandName])
}

/// Réglages du système d'expérience d'un serveur.
model LevelConfig {
  guildId           String   @id
  /// Gain d'XP par message : valeur tirée au hasard entre xpMin et xpMax.
  xpMin             Int      @default(15)
  xpMax             Int      @default(25)
  /// Délai minimal, en secondes, entre deux messages récompensés d'un même membre.
  cooldownSeconds   Int      @default(60)
  /// XP nécessaire pour passer du niveau n au niveau n+1 : levelBase + levelStep × n.
  levelBase         Int      @default(100)
  levelStep         Int      @default(50)
  announceEnabled   Boolean  @default(true)
  /// Salon des annonces de niveau ; vide = salon où le membre vient d'écrire.
  announceChannelId String?
  levelUpMessage    String   @default("🎉 Bravo {user}, tu passes au niveau **{level}** !")
  /// Vrai : le membre conserve les rôles des paliers précédents. Faux : seul le plus élevé est gardé.
  stackRewards      Boolean  @default(true)
  ignoredChannelIds String[] @default([])
  ignoredRoleIds    String[] @default([])
  updatedAt         DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

/// Expérience d'un membre sur un serveur.
model UserExperience {
  id           Int       @id @default(autoincrement())
  guildId      String
  userId       String
  /// XP total accumulé ; le niveau en est toujours déduit.
  xp           Int       @default(0)
  /// Dernier niveau constaté, pour détecter un passage de niveau.
  level        Int       @default(0)
  messageCount Int       @default(0)
  lastXpAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)])
}

/// Rôle attribué automatiquement lorsqu'un membre atteint un niveau.
model LevelReward {
  id        Int      @id @default(autoincrement())
  guildId   String
  level     Int
  roleId    String
  createdAt DateTime @default(now())

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, level])
  @@unique([guildId, roleId])
}

/// Nature d'un mouvement de monnaie.
enum TransactionType {
  DAILY
  WEEKLY
  PAY_SENT
  PAY_RECEIVED
  PURCHASE
  REFUND
  ADMIN_GIVE
  ADMIN_TAKE
}

/// Réglages de l'économie d'un serveur.
model EconomyConfig {
  guildId                String   @id
  currencyName           String   @default("pièces")
  currencyEmoji          String   @default("🪙")
  dailyAmount            Int      @default(100)
  weeklyAmount           Int      @default(500)
  /// Gain par message : valeur tirée au hasard entre messageMin et messageMax (0 et 0 = désactivé).
  messageMin             Int      @default(1)
  messageMax             Int      @default(3)
  messageCooldownSeconds Int      @default(60)
  updatedAt              DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

/// Portefeuille d'un membre sur un serveur. Le solde ne peut jamais être négatif (contrainte en base).
model EconomyAccount {
  id           Int       @id @default(autoincrement())
  guildId      String
  userId       String
  balance      Int       @default(0)
  lastDailyAt  DateTime?
  lastWeeklyAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, balance(sort: Desc)])
}

/// Mouvement de monnaie (hors gains par message, trop nombreux pour être conservés un à un).
model EconomyTransaction {
  id             Int             @id @default(autoincrement())
  guildId        String
  userId         String
  type           TransactionType
  /// Montant signé : positif pour un gain, négatif pour une dépense.
  amount         Int
  balanceAfter   Int
  /// Autre membre concerné (paiement) ou administrateur à l'origine du mouvement.
  counterpartyId String?
  /// Précision libre : nom de l'article acheté, par exemple.
  note           String?
  createdAt      DateTime        @default(now())

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Article de la boutique d'un serveur.
model ShopItem {
  id          Int      @id @default(autoincrement())
  guildId     String
  name        String
  description String   @default("")
  price       Int
  /// Rôle attribué à l'achat (facultatif).
  roleId      String?
  /// Exemplaires restants ; vide = illimité.
  stock       Int?
  /// Nombre maximal d'exemplaires par membre ; vide = illimité.
  maxPerUser  Int?
  /// Faux : l'article n'est plus en vente mais reste dans les inventaires.
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild     GuildConfig     @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  inventory InventoryItem[]

  @@unique([guildId, name])
}

/// Exemplaires d'un article possédés par un membre.
model InventoryItem {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  itemId    Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  item  ShopItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, itemId])
  @@index([itemId])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REFUSED
}

/// Réglages des suggestions d'un serveur.
model SuggestionConfig {
  guildId     String   @id
  /// Salon où les suggestions sont publiées.
  channelId   String?
  /// Rôle autorisé à traiter les suggestions, en plus des membres ayant « Gérer le serveur ».
  staffRoleId String?
  /// Compteur servant à numéroter les suggestions du serveur.
  counter     Int      @default(0)
  updatedAt   DateTime @updatedAt

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

/// Suggestion d'un membre, numérotée par serveur.
model Suggestion {
  id            Int              @id @default(autoincrement())
  guildId       String
  number        Int
  authorId      String
  content       String
  status        SuggestionStatus @default(PENDING)
  /// Message public de la suggestion (vide tant que la publication n'a pas abouti).
  channelId     String?
  messageId     String?
  /// Membre du staff ayant rendu la décision ou la dernière réponse.
  staffId       String?
  staffResponse String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  guild GuildConfig      @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  votes SuggestionVote[]

  @@unique([guildId, number])
  @@index([guildId, status, number(sort: Desc)])
  @@index([guildId, authorId])
}

/// Vote d'un membre sur une suggestion : un seul par membre.
model SuggestionVote {
  id           Int      @id @default(autoincrement())
  suggestionId Int
  userId       String
  /// +1 pour, -1 contre.
  value        Int
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

/// Sondage à boutons publié dans un salon.
model Poll {
  id          Int       @id @default(autoincrement())
  guildId     String
  channelId   String
  /// Message du sondage (vide tant que la publication n'a pas abouti).
  messageId   String?
  authorId    String
  question    String
  /// Vrai : un membre peut choisir plusieurs réponses.
  multiple    Boolean   @default(false)
  /// Vrai : les résultats ne sont affichés qu'à la clôture.
  hideResults Boolean   @default(false)
  endsAt      DateTime
  /// Date de clôture effective ; vide tant que le sondage est ouvert.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  guild   GuildConfig  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([closedAt, endsAt])
  @@index([guildId, createdAt(sort: Desc)])
}

/// Réponse proposée dans un sondage.
model PollOption {
  id       Int    @id @default(autoincrement())
  pollId   Int
  /// Ordre d'affichage, à partir de 0.
  position Int
  label    String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, position])
}

/// Vote d'un membre pour une réponse d'un sondage.
model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    Int
  optionId  Int
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

enum ParticipationStatus {
  GOING
  DECLINED
}

/// Événement communautaire annoncé dans un salon.
model Event {
  id             Int       @id @default(autoincrement())
  guildId        String
  channelId      String
  /// Message d'annonce (vide tant que la publication n'a pas abouti).
  messageId      String?
  creatorId      String
  title          String
  description    String    @default("")
  imageUrl       String?
  startsAt       DateTime
  /// Nombre maximal de participants ; vide = illimité.
  capacity       Int?
  /// Moment du rappel automatique ; vide = aucun rappel.
  reminderAt     DateTime?
  reminderSentAt DateTime?
  /// Renseigné quand le début de l'événement a été traité (inscriptions closes).
  startedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  guild        GuildConfig        @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  participants EventParticipant[]

  @@index([guildId, startsAt])
  @@index([startedAt, startsAt])
  @@index([reminderSentAt, reminderAt])
}

/// Réponse d'un membre à un événement : une seule par membre.
model EventParticipant {
  id        Int                 @id @default(autoincrement())
  eventId   Int
  userId    String
  status    ParticipationStatus
  createdAt DateTime            @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

/// Rappel personnel programmé par un membre.
model Reminder {
  id        Int       @id @default(autoincrement())
  guildId   String
  /// Salon où le rappel a été créé, et où il sera envoyé.
  channelId String
  userId    String
  message   String
  remindAt  DateTime
  /// Renseigné dès que l'envoi est pris en charge : un rappel n'est jamais envoyé deux fois.
  sentAt    DateTime?
  /// Nombre d'envois tentés, pour ne pas réessayer indéfiniment.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  guild GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([sentAt, remindAt])
  @@index([guildId, userId, sentAt])
}
