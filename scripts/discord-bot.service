# Unité systemd pour un déploiement Debian sans Docker.
# Installation : voir la section « Déploiement sur Debian » du README.
#   sudo cp scripts/discord-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now discord-bot

[Unit]
Description=Bot Discord
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/opt/discord-bot
EnvironmentFile=/opt/discord-bot/.env
Environment=NODE_ENV=production
ExecStartPre=/opt/discord-bot/node_modules/.bin/prisma migrate deploy
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

# Durcissement : le service ne peut écrire que dans son dossier de logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discord-bot/logs

[Install]
WantedBy=multi-user.target
